{
  "$schema": "https://opencode.ai/config.json",

  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],

  "model": "opencode/deepseek-v4.1-flash",

  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" }
  ],

  "agents": {
    "title": {
      "model": "opencode/deepseek-v4.1-flash"
    },
    "build": {
      "mode": "primary",
      "description": "Default primary agent for full development, file editing, and task execution."
    },
    "plan": {
      "mode": "primary",
      "model": "opencode/grok-4.7",
      "description": "Architectural analysis, SDD plan generation, and constraint definitions without editing files directly."
    },
    "debug": {
      "mode": "primary",
      "model": "opencode/glm-5.3-flash",
      "description": "Default primary agent for debugging and issue resolution."
    },
    "general": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash",
      "description": "General-purpose subagent for background execution passes, multi-step subtasks, and SDD task reviews."
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash",
      "description": "Fast, read-only codebase search, file path inspection, and string matching.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
